# Only required for model-backed writing and independent review.
OPENAI_API_KEY=
# Optional: Azure v1 base URL; omit /responses. Blank uses OpenAI directly.
# Example: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
OPENAI_BASE_URL=
# Set explicitly; for Azure, these are deployment names, not necessarily model IDs.
LAVIK_WRITER_MODEL=
LAVIK_REVIEWER_MODEL=
# GPT-6 Astra supports low, medium, high, xhigh, max. Blank uses the API default.
LAVIK_WRITER_REASONING_EFFORT=
LAVIK_REVIEWER_REASONING_EFFORT=
# Per-request output limits INCLUDE reasoning tokens. For xhigh, try 32000 each.
# Blank retains writer=5000, reviewer=2500.
LAVIK_WRITER_MAX_TOKENS=
LAVIK_REVIEWER_MAX_TOKENS=
# Whole writer/reviewer invocation timeout, including tools. Blank = 240000 ms.
# For xhigh, consider 900000 ms (15 minutes).
LAVIK_AGENT_TIMEOUT_MS=

# Private admin worker. Model keys stay on the runner, outside the website runtime.
LAVIK_ADMIN_URL=https://lavik.dev
LAVIK_RUNNER_TOKEN=
# Separate website publisher credential; GitHub LAVIK_PUBLISHER_TOKEN and Cloudflare PUBLISHER_TOKEN.
LAVIK_PUBLISHER_TOKEN=
# Optional local setup input; install as the Cloudflare GITHUB_DISPATCH_TOKEN secret.
# Fine-grained GitHub token: only this repository, Actions read/write.
LAVIK_GITHUB_DISPATCH_TOKEN=
