{
  "name": "lavik-marketing-test",
  "main": "worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 4175, "local_protocol": "http" },
  "vars": { "MARKETING_LOCAL": "true" },
  "durable_objects": {
    "bindings": [{ "name": "ANALYTICS_STORE", "class_name": "AnalyticsStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AnalyticsStore"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../apps/marketing/out",
    "run_worker_first": true,
    "html_handling": "none",
  },
}
