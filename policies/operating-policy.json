{
  "version": "0.1.0",
  "priority": ["accuracy", "usefulness", "clarity", "distribution"],
  "locales": ["en", "zh-CN"],
  "productStage": "beta; no customers or customer stories",
  "automaticPublishing": true,
  "enabledChannels": ["website"],
  "requireBilingualPair": true,
  "maxRevisionAttempts": 2,
  "maxTurnsPerAgent": 8,
  "maxArticlesPerCampaign": 2,
  "requireIndependentReview": true,
  "requireExecutionForCode": true,
  "benchmarkFiguresRequireScope": true,
  "allowGeneratedShell": false,
  "publicationTarget": "local content repository; production deploy requires configured CI",
  "deferredChannels": ["x", "reddit", "wechat", "medium", "rednote"],
  "allowDerivedClaimsWithExplicitAssumptions": true,
  "requireSlaClaimsToMatchMeasuredScope": true
}
