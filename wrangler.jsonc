{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lavik-dev",
  "main": "apps/worker/index.ts",
  "account_id": "50aa9d595550cc016bfbe6f23a757cca",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "routes": [{ "pattern": "lavik.dev", "custom_domain": true }],
  "vars": {
    "ADMIN_ENABLED": "false",
    "ADMIN_EMAIL": "Zhanghuan929@gmail.com",
  },
  "durable_objects": {
    "bindings": [
      { "name": "ADMIN_STORE", "class_name": "AdminStore" },
      { "name": "ANALYTICS_STORE", "class_name": "AnalyticsStore" },
    ],
  },
  "migrations": [
    { "tag": "admin-v1", "new_sqlite_classes": ["AdminStore"] },
    { "tag": "analytics-v1", "new_sqlite_classes": ["AnalyticsStore"] },
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/analytics/*",
      "/admin",
      "/admin/*",
      "/api/admin/*",
      "/api/runner/*",
      "/api/publisher/*",
      "/community/slack",
      "/community/slack/*",
      "/community/discord",
      "/community/discord/*",
    ],
    "directory": "./apps/web/out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
}
